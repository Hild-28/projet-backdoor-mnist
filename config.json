    "art_activation_defence": {
      "nb_dims": 10,
      "reduce": "PCA",
      "nb_clusters_testes": [
        2,
        3
      ],
      "regles_testees": [
        "smaller",
        "relative-size",
        "distance",
        "silhouette-scores"
      ]
    },
    "activation_clustering_trois_groupes": {
      "description": "Vérification aux faibles taux (cellules 32 et 33) : chaque groupe est jugé séparément",
