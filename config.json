      "regle": "groupe suspect si taille < 35 % de sa classe ET silhouette moyenne de ses propres points > 0.35",
      "silhouette": "silhouette_samples sur un échantillon de 3000 points par classe",
      "variantes_comparees": [
        "2 groupes (méthode initiale)",
        "3 groupes",
        "réunion 2, 3 et 4 groupes"
      ],
      "taux_etudies": [
        0.01,
        0.02,
        0.05,
        0.1
      ]
